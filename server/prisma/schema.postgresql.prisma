generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id             String                 @id @default(uuid())
  email          String                 @unique
  passwordHash   String
  firstName      String
  lastName       String
  roleId         String
  role           Role                   @relation(fields: [roleId], references: [id])
  avatarUrl      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  projectMembers ProjectMember[]
  configurations VehicleConfiguration[]
  reviews        EngineeringReview[]
  auditLogs      AuditLog[]

  @@index([email])
  @@index([roleId])
}

model AutomotiveProject {
  id                   String              @id @default(uuid())
  projectCode          String              @unique
  name                 String
  description          String
  status               String              @default("IN_ENGINEERING")
  budget               Float
  startDate            DateTime
  targetEndDate        DateTime
  completionPercentage Float               @default(0.0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  vehicleModels        VehicleModel[]
  projectMembers       ProjectMember[]
  milestones           ProjectMilestone[]
  reviews              EngineeringReview[]

  @@index([projectCode])
  @@index([status])
}

model ProjectMember {
  id           String            @id @default(uuid())
  projectId    String
  userId       String
  assignedRole String
  joinedAt     DateTime          @default(now())
  project      AutomotiveProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model VehicleModel {
  id          String            @id @default(uuid())
  projectId   String
  modelCode   String            @unique
  name        String
  segment     String
  year        Int
  description String
  createdAt   DateTime          @default(now())
  project     AutomotiveProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variants    VehicleVariant[]

  @@index([projectId])
  @@index([modelCode])
}

model VehicleVariant {
  id             String                 @id @default(uuid())
  modelId        String
  variantCode    String                 @unique
  name           String
  drivetrain     String
  basePrice      Float
  status         String                 @default("ACTIVE")
  createdAt      DateTime               @default(now())
  model          VehicleModel           @relation(fields: [modelId], references: [id], onDelete: Cascade)
  specifications VehicleSpecification?
  threeDModels   ThreeDModel[]
  components     VariantComponent[]
  configurations VehicleConfiguration[]

  @@index([modelId])
  @@index([variantCode])
}

model VehicleSpecification {
  id               String         @id @default(uuid())
  variantId        String         @unique
  rangeKm          Int
  acceleration0100 Float
  topSpeedKmh      Int
  peakPowerKw      Int
  batteryKwh       Float
  curbWeightKg     Int
  dragCoefficient  Float
  variant          VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model ComponentCategory {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  icon        String
  description String
  components  Component[]

  @@index([code])
}

model Supplier {
  id           String              @id @default(uuid())
  supplierCode String              @unique
  name         String
  tierLevel    String
  country      String
  contactEmail String
  rating       Float
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  components   ComponentSupplier[]

  @@index([supplierCode])
}

model Component {
  id             String                   @id @default(uuid())
  categoryId     String
  partNumber     String                   @unique
  name           String
  description    String
  manufacturer   String
  weightKg       Float
  costUsd        Float
  status         String                   @default("APPROVED")
  meshType       String
  createdAt      DateTime                 @default(now())
  category       ComponentCategory        @relation(fields: [categoryId], references: [id])
  suppliers      ComponentSupplier[]
  specifications ComponentSpecification[]
  variants       VariantComponent[]
  configurations ConfigurationComponent[]

  @@index([categoryId])
  @@index([partNumber])
  @@index([status])
}

model ComponentSupplier {
  id                    String    @id @default(uuid())
  componentId           String
  supplierId            String
  leadTimeDays          Int
  unitCost              Float
  supplyAgreementStatus String    @default("ACTIVE")
  component             Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  supplier              Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([componentId, supplierId])
  @@index([componentId])
  @@index([supplierId])
}

model ComponentSpecification {
  id          String    @id @default(uuid())
  componentId String
  specKey     String
  specValue   String
  unit        String?
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId])
}

model VariantComponent {
  id              String         @id @default(uuid())
  variantId       String
  componentId     String
  isStandard      Boolean        @default(true)
  isOptional      Boolean        @default(false)
  positionOffsetX Float          @default(0)
  positionOffsetY Float          @default(0)
  positionOffsetZ Float          @default(0)
  variant         VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  component       Component      @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([variantId, componentId])
  @@index([variantId])
  @@index([componentId])
}

model ThreeDModel {
  id               String         @id @default(uuid())
  variantId        String
  meshName         String
  fileFormat       String         @default("GLTF/Procedural")
  verticesCount    Int
  lodLevels        Int            @default(3)
  renderProperties String
  createdAt        DateTime       @default(now())
  variant          VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model VehicleConfiguration {
  id              String                   @id @default(uuid())
  variantId       String
  userId          String
  configCode      String                   @unique
  name            String
  totalPrice      Float
  totalWeight     Float
  calculatedRange Int
  status          String                   @default("SAVED")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  variant         VehicleVariant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  components      ConfigurationComponent[]

  @@index([variantId])
  @@index([userId])
  @@index([configCode])
}

model ConfigurationComponent {
  id              String               @id @default(uuid())
  configurationId String
  componentId     String
  colorOverride   String?
  customNotes     String?
  configuration   VehicleConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  component       Component            @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([configurationId, componentId])
  @@index([configurationId])
  @@index([componentId])
}

model ProjectMilestone {
  id          String            @id @default(uuid())
  projectId   String
  title       String
  description String
  phase       String
  targetDate  DateTime
  isCompleted Boolean           @default(false)
  completedAt DateTime?
  weight      Float             @default(1.0)
  project     AutomotiveProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([phase])
}

model EngineeringReview {
  id          String            @id @default(uuid())
  projectId   String
  reviewerId  String
  title       String
  reviewType  String
  status      String            @default("PENDING")
  score       Float?
  comments    String
  reviewDate  DateTime          @default(now())
  project     AutomotiveProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer    User              @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([reviewerId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  tableName String
  recordId  String
  action    String
  changedBy String?
  oldValues String?
  newValues String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [changedBy], references: [id])

  @@index([tableName])
  @@index([recordId])
  @@index([createdAt])
}
