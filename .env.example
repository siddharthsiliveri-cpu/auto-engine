# ===================================================
# AUTOENGINE - Environment Configuration
# ===================================================

# Node Environment
NODE_ENV=development
PORT=5000
CLIENT_PORT=3000

# Database Configuration (PostgreSQL / Supabase / Railway)
# For production PostgreSQL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/autoengine?schema=public"
# For zero-config local development, SQLite fallback is supported:
# DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET="autoengine-quantum-secret-key-2026-design-the-future"
JWT_EXPIRES_IN="7d"

# Client Application URL
CLIENT_URL="http://localhost:3000"

# Optional: Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"
